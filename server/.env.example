PORT=4000
# Doctor credential and password-change emails (verified sender required).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Status templates: recipient name, date/time IST, booking reference, status.
WHATSAPP_PATIENT_STATUS_TEMPLATE=
WHATSAPP_DOCTOR_STATUS_TEMPLATE=
# Direct Meta WhatsApp Cloud API (server only).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Supported Graph API version from your Meta app, e.g. v27.0.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PATIENT_TEMPLATE=gmc_patient_appointment
WHATSAPP_DOCTOR_TEMPLATE=gmc_doctor_appointment
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Generate a long random token; enter it in the admin sign-in screen. Never prefix it with VITE_.
ADMIN_API_TOKEN=
# Optional legacy JSON import source only; the running API always requires DATABASE_URL.
ADMIN_DATA_FILE=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Production: https://getmedconnect.techifylabs.in,https://get-med-connect.vercel.app,https://get-med-connect-3tdz.vercel.app
DATABASE_URL=
DATABASE_URL_UNPOOLED=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
GOOGLE_SHEET_ID=
# Paste the full service-account JSON on ONE line. Preserve escaped \n in the private key.
GOOGLE_SERVICE_ACCOUNT_JSON=
