PORT=4000
# Generate a long random token; enter it in the admin sign-in screen. Never prefix it with VITE_.
ADMIN_API_TOKEN=
# Local development storage only. Use a durable database before cloud deployment.
ADMIN_DATA_FILE=
# Firebase Admin credentials for admin-managed doctor logins. Keep the JSON key outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for hosted server environments: service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Must match doctor/.env VITE_FIREBASE_PROJECT_ID and the service-account project.
FIREBASE_PROJECT_ID=
# Neon CLI writes these to the repository-root .env.local (or root .env).
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_SHEET_ID=
# Paste the full service-account JSON on ONE line. Preserve escaped \n in the private key.
GOOGLE_SERVICE_ACCOUNT_JSON=
