{
  "name": "getmedconnect",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
